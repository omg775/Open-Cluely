# Postgres connection string (Neon on Vercel, local Postgres in dev)
DATABASE_URL=

# 32+ byte random string: openssl rand -base64 32
# Signs session cookies
SESSION_SECRET=

# Server-side only. Read exclusively by src/lib/anthropic.ts, never sent to a
# browser and never prefixed with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Answers per account per rolling 24h, since one key pays for everyone
ASSISTANT_DAILY_REQUEST_LIMIT=200

# Public base URL of this app, handed to the desktop app in the launch deep link
NEXT_PUBLIC_APP_URL=http://localhost:3000
