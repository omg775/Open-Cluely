# ====================================================================
# Claude (Anthropic) Configuration — required
# ====================================================================
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Reasoning model. Sonnet keeps the overlay responsive; switch to
# claude-opus-4-5 for deeper answers at higher latency.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional tuning
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=60000
ANTHROPIC_MAX_RETRIES=2
# Set to false to wait for the full response instead of streaming it
ANTHROPIC_STREAMING=true

# Request pacing
LLM_MIN_REQUEST_INTERVAL_MS=1200
LLM_TRANSCRIPT_DEBOUNCE_MS=900
LLM_MAX_HISTORY_TURNS=15

# ====================================================================
# Speech Recognition Configuration (whisper = free + local, or azure)
# ====================================================================
SPEECH_PROVIDER=whisper

# Which audio to listen to:
#   both       microphone + the call audio coming out of your speakers
#   system     only the far end of the call (needs an OS loopback source)
#   microphone only you
SPEECH_AUDIO_SOURCE=both

# Optional explicit ffmpeg input, e.g.
#   pulse:alsa_output.pci-0000_00_1f.3.analog-stereo.monitor   (Linux)
#   avfoundation::2                                            (macOS, BlackHole)
#   dshow:audio=CABLE Output (VB-Audio Virtual Cable)          (Windows)
SPEECH_AUDIO_DEVICE=

# Path to ffmpeg if it is not on PATH
FFMPEG_PATH=

# Voice-activity detection / endpointing
SPEECH_SILENCE_THRESHOLD=0.012
SPEECH_ENDPOINT_SILENCE_MS=600
SPEECH_MIN_UTTERANCE_MS=400
SPEECH_MAX_UTTERANCE_MS=12000
SPEECH_PREROLL_MS=300

# ====================================================================
# Azure Speech Services Configuration
# ====================================================================
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=your-azure-region-here

# ====================================================================
# Local Whisper Configuration (whisper.cpp — free, offline)
# ====================================================================
# Leave WHISPER_COMMAND blank to auto-detect whisper-server/whisper-cli on PATH
WHISPER_COMMAND=
WHISPER_MODEL_DIR=.whisper-models
# tiny.en answers in ~1s; base.en is more accurate and roughly 2x slower
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en
WHISPER_THREADS=0
WHISPER_TIMEOUT_MS=30000
